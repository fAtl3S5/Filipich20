# Application
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8741
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_WEB_TOKEN=change-me-admin-panel-token

# Telegram
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Bothost default path is /webhook (also /webhooks/telegram works)
TELEGRAM_WEBHOOK_PATH=/webhook
SET_TELEGRAM_WEBHOOK=true
# Owner production IDs (non-secret) — also set these in Bothost panel env
ADMIN_IDS=475444567
# Numeric chat IDs (bot must be admin of both)
CHANNEL_ID=-1004373038215
DISCUSSION_GROUP_ID=-1004381561059
# Optional public invite used only for owner bootstrap docs — never open unprotected invites in production
CHANNEL_INVITE_HINT=https://t.me/+ymhxwNravd9hMzUy
DISCUSSION_INVITE_HINT=https://t.me/+2MH4qJ7o8Mg1NmIy
# Extra telegram user IDs that must never be banned by expire jobs
BAN_ALLOWLIST=

# Payments — YooKassa (independent web checkout)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:8741/checkout/return
# Production default: false. Do NOT enable bot-initiated YooKassa without a compliance review.
ENABLE_BOT_INITIATED_YOOKASSA=false
# Owner: YooKassa skipped for now — keep false until shop credentials are ready
ENABLE_WEB_YOOKASSA=false

# Telegram Stars (XTR). Owner-set XTR amounts (not RUB). 0/empty hides that plan.
# Current Bothost test tariffs:
STARS_PRICE_1M=1
STARS_PRICE_3M=2
STARS_PRICE_6M=3
STARS_PRICE_12M=5
ENABLE_STARS=true

# Telegram Login Widget (web binding)
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_AUTH_DATE_MAX_AGE=86400

# Support / legal
SUPPORT_URL=https://t.me/kovalg29
TERMS_URL=
PAYSUPPORT_URL=

# Database
# Local docker-compose Postgres:
DATABASE_URL=postgresql+asyncpg://filippych:filippych@db:5432/filippych
# Bothost recommended: external managed Postgres connection string (asyncpg).
# Bothost emergency fallback (single-container SQLite on persistent volume):
# DATABASE_URL=sqlite-bothost
# DATA_DIR=/app/data

# Timezone display
DISPLAY_TIMEZONE=Asia/Novosibirsk

# Jobs (in-process durable worker runs inside the API process)
JOB_POLL_INTERVAL_SEC=5
EXPIRE_SWEEP_INTERVAL_SEC=60

# Broadcasts
BROADCAST_RATE_LIMIT_PER_SEC=25

# --- Bothost panel injects (do not invent values; leave blank in .env.example) ---
# DOMAIN=bot-xxxx-user.bothost.tech
# PORT=8080
# DATA_DIR=/app/data
# BOT_ID=
# USER_ID=
